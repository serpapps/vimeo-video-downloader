{
  "manifest_version": 3,
  "name": "Downloader for Vimeo",
  "version": "4.0.9",
  "description": "One-click video downloads from Vimeo — fast, private, and full quality.",
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "scripting",
    "webNavigation",
    "offscreen",
    "cookies",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://auth.serp.co/*",
    "https://vimeo.com/*",
    "https://*.vimeo.com/*",
    "https://*.vimeocdn.com/*",
    "https://*.cloudfront.net/*",
    "https://unpkg.com/*",
    "https://api.gumroad.com/*",
    "https://player.vimeo.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "serp-bundles/background-service-worker.graph.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "serp-bundles/content-1.graph.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://vimeo.com/*",
        "https://*.vimeo.com/*",
        "https://player.vimeo.com/*",
        "https://*.vhx.tv/*",
        "https://embed.vhx.tv/*"
      ],
      "js": [
        "serp-bundles/content-2.bundle.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Downloader for Vimeo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "offscreen-faststream.html",
        "offscreen-faststream-legacy.js",
        "indexed-db.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "modules/**/*",
        "download-manager/**/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    },
    {
      "resources": [
        "download-manager/integration-helper.js",
        "download-manager/download-manager.js",
        "download-manager/download-manager-ui.js",
        "download-manager/download-manager-state.js",
        "download-manager/download-manager-config.js"
      ],
      "matches": [
        "https://vimeo.com/*",
        "https://*.vimeo.com/*",
        "https://player.vimeo.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' ; child-src 'self';"
  }
}
